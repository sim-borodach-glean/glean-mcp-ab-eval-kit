{
  "_comment": "Cursor host example, scoped to the small 3-prompt baseline. Arm B is vendor-direct = Atlassian + Slack. Copy to eval.config.json and copy the cursor-shaped mcp templates into mcp/. Server identifiers (Atlassian-MCP-Server, slack, glean_default) MUST match the identifiers in your ~/.cursor/mcp.json, because cursor-agent resolves servers by those canonical names. The kit auto-isolates each arm (cursor_manage_global_mcp) and auto-authenticates the arm's servers (cursor_ensure_auth).",
  "eval_name": "cursor-glean-mcp-ab-eval",
  "host": "cursor",
  "mcp_mode": "strict",
  "prompts_file": "golden_prompts.tsv",
  "results_dir": "results",
  "model": "claude-sonnet-5-high",
  "judge_model": "opus",
  "judge_host": "claude-code",
  "judge_mcp_config": "config/mcp.none.json",
  "judge_hide_tokens": false,
  "max_turns": 20,
  "default_disallow_builtin_tools": true,
  "require_preflight_before_run": true,
  "require_live_preflight_before_run": true,
  "cursor_manage_global_mcp": true,
  "cursor_ensure_auth": true,
  "prompt_wrapper": "Answer the following enterprise knowledge question. This task is STRICTLY READ-ONLY: use only search and read tools to find current, grounded sources. Never create, edit, comment on, transition, delete, or otherwise modify any content, and never use a write action as a workaround to reach data. Cite source names/URLs when available. If you cannot find enough evidence, say what is missing.\n\nQuestion:\n{prompt}",
  "preflight_timeout_seconds": 400,
  "run_timeout_seconds": 900,
  "pricing_per_million": {
    "input_tokens": 5.0,
    "output_tokens": 25.0,
    "cache_creation_input_tokens": 6.25,
    "cache_read_input_tokens": 0.5
  },
  "arms": {
    "glean": {
      "label": "Glean MCP",
      "mcp_config": "mcp/glean.mcp.json",
      "expected_mcp_servers": ["glean_default"],
      "forbidden_mcp_servers": ["Atlassian-MCP-Server", "slack", "github", "google_drive", "jira", "confluence", "notion", "gmail", "outlook", "zoom", "salesforce"],
      "allowed_tools": ["mcp__glean_default__search", "mcp__glean_default__read_document", "mcp__glean_default__chat", "mcp__glean_default__employee_search", "mcp__glean_default__code_search"],
      "disallowed_tools": ["mcp__glean_default__run_tool", "mcp__glean_default__find_skills", "mcp__glean_default__read_skill_files", "mcp__glean_default__memory"],
      "preflight_prompt": "Use the Glean MCP tools to perform a harmless read-only search for a known internal page and return a one-sentence confirmation that retrieval worked."
    },
    "direct": {
      "label": "Atlassian + Slack (direct)",
      "mcp_config": "mcp/direct.mcp.json",
      "expected_mcp_servers": ["Atlassian-MCP-Server", "slack"],
      "forbidden_mcp_servers": ["glean_default", "glean"],
      "require_live_tool_servers": ["Atlassian-MCP-Server", "slack"],
      "allowed_tools": [
        "mcp__Atlassian-MCP-Server__search",
        "mcp__Atlassian-MCP-Server__fetch",
        "mcp__Atlassian-MCP-Server__getAccessibleAtlassianResources",
        "mcp__Atlassian-MCP-Server__getJiraIssue",
        "mcp__Atlassian-MCP-Server__getConfluencePage",
        "mcp__Atlassian-MCP-Server__searchJiraIssuesUsingJql",
        "mcp__Atlassian-MCP-Server__searchConfluenceUsingCql",
        "mcp__Atlassian-MCP-Server__getConfluenceSpaces",
        "mcp__Atlassian-MCP-Server__getPagesInConfluenceSpace",
        "mcp__Atlassian-MCP-Server__lookupJiraAccountId",
        "mcp__Atlassian-MCP-Server__getVisibleJiraProjects",
        "mcp__Atlassian-MCP-Server__atlassianUserInfo",
        "mcp__slack__slack_search_public",
        "mcp__slack__slack_search_public_and_private",
        "mcp__slack__slack_search_channels",
        "mcp__slack__slack_search_users",
        "mcp__slack__slack_read_channel",
        "mcp__slack__slack_read_thread",
        "mcp__slack__slack_read_user_profile"
      ],
      "disallowed_tools": [
        "mcp__Atlassian-MCP-Server__addCommentToJiraIssue",
        "mcp__Atlassian-MCP-Server__editJiraIssue",
        "mcp__Atlassian-MCP-Server__createJiraIssue",
        "mcp__Atlassian-MCP-Server__transitionJiraIssue",
        "mcp__Atlassian-MCP-Server__addWorklogToJiraIssue",
        "mcp__Atlassian-MCP-Server__createIssueLink",
        "mcp__Atlassian-MCP-Server__createConfluencePage",
        "mcp__Atlassian-MCP-Server__createConfluenceFooterComment",
        "mcp__Atlassian-MCP-Server__createConfluenceInlineComment",
        "mcp__slack__slack_send_message",
        "mcp__slack__slack_schedule_message",
        "mcp__slack__slack_send_message_draft",
        "mcp__slack__slack_create_canvas",
        "mcp__slack__slack_update_canvas"
      ],
      "preflight_prompt": "Do two harmless READ-ONLY actions, then confirm both ran: (1) Atlassian: search for the term \"policy\"; (2) Slack: slack_search_public for \"hello\". Return one sentence per tool stating whether it returned results."
    }
  }
}
